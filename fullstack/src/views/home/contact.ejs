<%- contentFor('content') %>
<section class="mt-4 mb-4">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">Contact Page</h2>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- contact info -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-semibold text-gray-800 mb-6">Contact information</h3>

        <div class="flex items-center mb-5">
          <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center mr-4 shrink-0">
            <i class="fas fa-envelope text-white"></i>
          </div>
          <div>
            <p class="text-sm text-gray-500">Email</p>
            <p class="text-gray-800 font-medium">contact@libraryapp.com</p>
          </div>
        </div>

        <div class="flex items-center mb-5">
          <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center mr-4 shrink-0">
            <i class="fas fa-phone text-white"></i>
          </div>
          <div>
            <p class="text-sm text-gray-500">Phone</p>
            <p class="text-gray-800 font-medium">+57 300 000 0000</p>
          </div>
        </div>

        <div class="flex items-center">
          <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center mr-4 shrink-0">
            <i class="fas fa-map-marker-alt text-white"></i>
          </div>
          <div>
            <p class="text-sm text-gray-500">Address</p>
            <p class="text-gray-800 font-medium">Bogotá, Colombia</p>
          </div>
        </div>
      </div>

      <!-- form (visual only) -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-semibold text-gray-800 mb-6">Send us a message</h3>

        <form class="space-y-4">
          <div>
            <label class="block text-sm text-gray-500 mb-1">Name</label>
            <input type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your name">
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1">Email</label>
            <input type="email" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="you@email.com">
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1">Message</label>
            <textarea rows="4" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Write your message..."></textarea>
          </div>
          <button type="button" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg px-4 py-2 transition duration-200">
            Send
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
